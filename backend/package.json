{
  "name": "simsa-backend",
  "version": "1.0.0",
  "description": "SIMSA Backend API - Express + Drizzle + Better Auth",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/app.ts --format esm",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:unit-kerja": "tsx src/db/seeds/seed-unit-kerja.ts",
    "seed:klasifikasi": "tsx src/db/seed-klasifikasi.ts",
    "seed:jra": "tsx src/db/seed-jra.ts",
    "seed:mapping": "tsx src/db/seed-mapping.ts",
    "seed:all": "tsx src/db/seed.ts",
    "seed:tester": "tsx src/db/seed-tester.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "simsa",
    "atrbpn",
    "express",
    "drizzle"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.1",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.5",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.8",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
