    "express-rate-limit": "^8.2.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pdfjs-dist": "^5.4.624",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
