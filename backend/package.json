{
  "name": "simsa-backend",
  "version": "1.0.0",
  "description": "SIMSA Backend API - Express, PostgreSQL, Better Auth, and private Vercel Blob storage",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/app.ts src/scripts/backfill-letter-attachment-scan.ts src/workers/malware-scan.ts src/workers/ocr-process.ts src/workers/srikandi.ts src/workers/blob-reconciliation.ts src/workers/file-fixity.ts --format esm --no-dts --clean",
    "start": "node dist/index.js",
    "files:letter-scan-backfill:plan": "tsx src/scripts/backfill-letter-attachment-scan.ts",
    "files:letter-scan-backfill:apply": "tsx src/scripts/backfill-letter-attachment-scan.ts --apply",
    "rangkaian:backfill-lama:plan": "node scripts/backfill-rangkaian-lama.mjs",
    "rangkaian:backfill-lama:apply": "node scripts/backfill-rangkaian-lama.mjs --apply",
    "rangkaian:backfill-lama:isi-pengolah:plan": "node scripts/backfill-rangkaian-lama.mjs --isi-pengolah",
    "rangkaian:backfill-lama:isi-pengolah:apply": "node scripts/backfill-rangkaian-lama.mjs --isi-pengolah --apply",
    "start:files:letter-scan-backfill:plan": "node dist/scripts/backfill-letter-attachment-scan.js",
    "start:files:letter-scan-backfill:apply": "node dist/scripts/backfill-letter-attachment-scan.js --apply",
    "dev:malware-worker": "tsx src/workers/malware-scan.ts",
    "start:malware-worker": "node dist/workers/malware-scan.js",
    "dev:srikandi-worker": "tsx src/workers/srikandi.ts",
    "start:srikandi-worker": "node dist/workers/srikandi.js",
    "dev:blob-reconciler": "tsx src/workers/blob-reconciliation.ts",
    "start:blob-reconciler": "node dist/workers/blob-reconciliation.js",
    "start:file-fixity": "node dist/workers/file-fixity.js",
    "dev:file-fixity": "tsx src/workers/file-fixity.ts",
    "smoke:clamav": "tsx scripts/clamav-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:roles:bootstrap": "node scripts/apply-database-role-bootstrap.mjs",
    "db:grants:converge": "node scripts/apply-database-grant-convergence.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:backfill:rangkaian-disposisi": "node scripts/backfill-rangkaian-disposisi.mjs",
    "db:preflight:integrasi-surat": "node scripts/preflight-integrasi-surat.mjs",
    "db:studio": "drizzle-kit studio",
    "seed:unit-kerja": "tsx src/db/seeds/seed-unit-kerja.ts",
    "seed:klasifikasi": "tsx src/db/seed-klasifikasi.ts",
    "seed:jra": "tsx src/db/seed-jra.ts",
    "seed:mapping": "tsx src/db/seed-mapping.ts",
    "seed:all": "tsx src/db/seed.ts",
    "seed:deployment": "tsx src/db/seed-deployment.ts",
    "seed:tester": "tsx src/db/seed-tester.ts",
    "test": "vitest run",
    "test:postgres-locks": "node -e \"if (!process.env.TEST_POSTGRES_URL) throw new Error('TEST_POSTGRES_URL is required')\" && vitest run --config vitest.postgres.config.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "simsa",
    "atrbpn",
    "express",
    "drizzle"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "3.10.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.14",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "7.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "esbuild": "0.28.2",
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "better-auth": {
      "vitest": "$vitest"
    }
  }
}
