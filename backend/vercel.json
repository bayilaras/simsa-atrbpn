{
    "version": 2,
    "framework": null,
    "fluid": true,
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "buildCommand": "node scripts/build-vercel.mjs",
    "installCommand": "npm ci --include=dev",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.js"
        }
    ]
}
