{
    "version": 2,
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "buildCommand": "npm run build",
    "installCommand": "npm ci --include=dev",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.js"
        }
    ]
}
