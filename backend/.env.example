# Environment
NODE_ENV=development
APP_PROFILE=internal
PORT=3001

# Database - Neon PostgreSQL
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/simsa?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
# Production: set this to the same public origin as FRONTEND_URL; that origin
# must proxy /api/auth. Do not use the separate backend deployment hostname.
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
# OAuth only authenticates users already provisioned by a SIMSA administrator;
# the application deliberately disables implicit Google-account sign-up.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Import spreadsheet hanya menerima Google Sheets publik lewat URL yang
# divalidasi dan tidak memakai kredensial Drive sebagai penyimpanan arsip.
# Bitstream kanonik selalu disimpan pada private Vercel Blob di bawah.

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Optional comma-separated exact origins only. Preview aliases must be listed
# explicitly; never use a wildcard such as https://*.vercel.app.
ADDITIONAL_TRUSTED_ORIGINS=

# Private Vercel Blob storage. This backend-only secret is also mandatory for
# rule-set-bound direct upload, server refetch/fixity verification, and exact
# retention of classification/JRA source PDFs up to 50 MiB. Never expose it as
# a VITE_* variable or place it in a browser bundle.
BLOB_READ_WRITE_TOKEN=your-private-vercel-blob-read-write-token
# Required outside Vercel and on Vercel Preview so the Blob service can post its
# signed completion callback. Preview must use a public, unprotected custom HTTPS
# origin (never a protected *.vercel.app URL). The Blob SDK appends the request
# path (/api/client-upload) itself. Do not add a trailing slash.
# VERCEL_BLOB_CALLBACK_URL=https://api.example.go.id
# Direct uploads must be claimed by a business transaction before this window.
CLIENT_BLOB_UPLOAD_TTL_HOURS=24
CLIENT_BLOB_RECONCILE_BATCH_SIZE=100

# Optional SMTP delivery. Leave every value empty to keep email explicitly
# disabled. A partial configuration is reported as degraded by /api/health.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Hard upper bound for each SMTP connection/greeting/socket wait (1-30 seconds).
SMTP_TIMEOUT_MS=10000

# Controlled bitstream malware scanning
# Internal deployments may temporarily keep this disabled only in fail-closed
# quarantine mode: uploaded files remain unavailable until a clean scan exists.
# Integrated production requires "clamav", an enabled worker, and
# CLAMAV_TRUSTED_NETWORK=true on a private network.
MALWARE_SCANNER_MODE=disabled
MALWARE_SCAN_WORKER_ENABLED=false
# Use embedded only in a persistent Node process. Vercel must use external and
# run `npm run start:malware-worker` in a separate persistent private runtime.
MALWARE_SCAN_WORKER_RUNTIME=embedded
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TRUSTED_NETWORK=false
CLAMAV_CONNECT_TIMEOUT_MS=5000
CLAMAV_SCAN_TIMEOUT_MS=120000
# clamd.conf StreamMaxLength must be at least this value (50 MiB here).
CLAMAV_MAX_STREAM_BYTES=52428800
MALWARE_SCAN_DOWNLOAD_TIMEOUT_MS=30000

# OCR PDF scan. Production requires a controlled directory/URL containing
# ind.traineddata.gz and eng.traineddata.gz. Development may omit this and use
# the upstream tesseract.js language-data endpoint. OCR always fails closed if
# the models cannot be loaded within the service timeout.
OCR_TESSDATA_PATH=
# Optional writable cache directory. Defaults to the operating-system temp dir.
OCR_CACHE_PATH=
# Kapasitas OCR global tidak dikonfigurasi per-instance. Migrasi 0026 menyimpan
# max_concurrency, durasi lease, dan Retry-After secara otoritatif di tabel
# ocr_capacity_control agar seluruh replica memakai batas yang sama.
MALWARE_SCAN_INTERVAL_MS=15000
MALWARE_SCAN_BATCH_SIZE=5
MALWARE_SCAN_STALE_AFTER_MS=180000
MALWARE_SCAN_MAX_ATTEMPTS=5
MALWARE_SCAN_RETRY_BASE_MS=30000
MALWARE_SCAN_RETRY_MAX_MS=900000

# SRIKANDI durable outbox integration
# Set APP_PROFILE=integrated before explicitly enabling external delivery.
# Outbound HTTP is disabled unless this is explicitly true AND every required
# official endpoint/contract field below has been supplied and validated.
SRIKANDI_ENABLED=false
SRIKANDI_BASE_URL=
SRIKANDI_SYNC_PATH=
SRIKANDI_API_TOKEN=
SRIKANDI_CONTRACT_VERSION=
SRIKANDI_ACK_FIELD=
SRIKANDI_ACK_VALUE=
SRIKANDI_REMOTE_ID_FIELD=
# Transactional producer has a separate switch from outbound delivery. Keep it
# false until the official payload mapping and event names are approved.
SRIKANDI_PRODUCER_ENABLED=false
SRIKANDI_PRODUCER_PAYLOAD_PROFILE=
SRIKANDI_SURAT_MASUK_CREATED_EVENT=
SRIKANDI_SURAT_KELUAR_CREATED_EVENT=
# Optional HTTP/retry policy overrides
# SRIKANDI_AUTH_HEADER=Authorization
# SRIKANDI_AUTH_PREFIX="Bearer "
# SRIKANDI_IDEMPOTENCY_HEADER=Idempotency-Key
SRIKANDI_TIMEOUT_MS=15000
SRIKANDI_MAX_ATTEMPTS=5
SRIKANDI_BACKOFF_BASE_SECONDS=60
SRIKANDI_BACKOFF_MAX_SECONDS=3600
# Persistent worker (the production delivery path)
SRIKANDI_WORKER_POLL_MS=5000
SRIKANDI_WORKER_BATCH_SIZE=10
