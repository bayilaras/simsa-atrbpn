# Local metadata demo only. Copy to the ignored .env.demo.local at repo root.
# Never use the Production database or real archive data. Blank secrets fail closed.
NODE_ENV=development
PORT=8080
SIMSA_APP_MODE=metadata-demo
SIMSA_CLOUD_PLATFORM=local
APP_PROFILE=internal
SIMSA_DEMO_DATA_ACKNOWLEDGED=true
SIMSA_DEMO_DATABASE=simsa_demo_local
DB_NAME=simsa_demo_local

# Supply the isolated database's API runtime login, NOT owner/migrator/maintenance.
# Apply the existing role bootstrap, migration and grant-convergence runbook first.
DATABASE_URL=
AUTH_PROVIDER=better-auth
SIMSA_DEMO_LOCAL_AUTH=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8080
FRONTEND_URL=http://127.0.0.1:8080

OBJECT_STORAGE_PROVIDER=disabled
SRIKANDI_ENABLED=false
MALWARE_SCANNER_MODE=disabled
MALWARE_SCAN_WORKER_ENABLED=false
# No storage bucket/token, SMTP, service-account key, or Firebase debug token.
