# Copy to .env and replace every placeholder before starting the workers.
DATABASE_URL=postgresql://simsa:replace-me@database.example:5432/simsa?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
CLIENT_BLOB_UPLOAD_TTL_HOURS=24
CLIENT_BLOB_RECONCILE_BATCH_SIZE=100

# Persistent antivirus worker
MALWARE_SCAN_WORKER_ENABLED=true
MALWARE_SCAN_WORKER_RUNTIME=external
CLAMAV_TRUSTED_NETWORK=true
CLAMAV_MAX_STREAM_BYTES=52428800
CLAMAV_CONNECT_TIMEOUT_MS=5000
CLAMAV_SCAN_TIMEOUT_MS=120000
MALWARE_SCAN_DOWNLOAD_TIMEOUT_MS=30000
MALWARE_SCAN_INTERVAL_MS=15000
MALWARE_SCAN_BATCH_SIZE=5
MALWARE_SCAN_STALE_AFTER_MS=180000
MALWARE_SCAN_MAX_ATTEMPTS=5
MALWARE_SCAN_RETRY_BASE_MS=30000
MALWARE_SCAN_RETRY_MAX_MS=900000

# Resource and log limits. Adjust only after measuring the target host.
CLAMAV_MEMORY_LIMIT=4g
CLAMAV_CPU_LIMIT=2.0
MALWARE_WORKER_MEMORY_LIMIT=1g
MALWARE_WORKER_CPU_LIMIT=1.0
SRIKANDI_WORKER_MEMORY_LIMIT=512m
SRIKANDI_WORKER_CPU_LIMIT=0.5
BLOB_RECONCILER_MEMORY_LIMIT=512m
BLOB_RECONCILER_CPU_LIMIT=0.5
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=5
# Local compose.local.yml builds this tag. Production compose.yml must instead
# use an immutable registry reference such as registry.example/simsa:v1@sha256:...
SIMSA_WORKER_IMAGE=simsa-worker:local

# Optional SRIKANDI profile. docker compose only starts this service when the
# `srikandi` profile is selected. Keep false until the official contract,
# sandbox, credentials, ACK, and remote-ID fields have been approved.
SRIKANDI_ENABLED=false
SRIKANDI_BASE_URL=https://sandbox.example.invalid
SRIKANDI_SYNC_PATH=/replace-with-approved-path
SRIKANDI_API_TOKEN=replace-me
SRIKANDI_AUTH_HEADER=Authorization
SRIKANDI_AUTH_PREFIX="Bearer "
SRIKANDI_IDEMPOTENCY_HEADER=Idempotency-Key
SRIKANDI_CONTRACT_VERSION=replace-me
SRIKANDI_ACK_FIELD=replace.me
SRIKANDI_ACK_VALUE=replace-me
SRIKANDI_REMOTE_ID_FIELD=replace.me
SRIKANDI_TIMEOUT_MS=15000
SRIKANDI_MAX_ATTEMPTS=5
SRIKANDI_BACKOFF_BASE_SECONDS=30
SRIKANDI_BACKOFF_MAX_SECONDS=3600
SRIKANDI_WORKER_POLL_MS=15000
SRIKANDI_WORKER_BATCH_SIZE=10
