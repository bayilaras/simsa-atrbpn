# Store only these operator-controlled tuning values as the raw payload of one
# pinned simsa-worker-environment Secret Manager version. The bootstrap appends
# Terraform-controlled project, database, bucket, socket, and image values.
# Never add DATABASE_URL, DB_PASSWORD, GOOGLE_APPLICATION_CREDENTIALS, a service
# account JSON key, image references, or Cloud SQL identifiers to this payload.

MALWARE_SCAN_WORKER_ENABLED=true
MALWARE_SCAN_WORKER_RUNTIME=external
CLAMAV_TRUSTED_NETWORK=true
CLAMAV_MAX_STREAM_BYTES=52428800
CLAMAV_CONNECT_TIMEOUT_MS=5000
CLAMAV_SCAN_TIMEOUT_MS=120000
MALWARE_SCAN_DOWNLOAD_TIMEOUT_MS=30000
MALWARE_SCAN_INTERVAL_MS=15000
MALWARE_SCAN_BATCH_SIZE=5
MALWARE_SCAN_STALE_AFTER_MS=180000
MALWARE_SCAN_MAX_ATTEMPTS=5
MALWARE_SCAN_RETRY_BASE_MS=30000
MALWARE_SCAN_RETRY_MAX_MS=900000

# e2-standard-2 (8 GiB) is the baseline for these limits. Do not deploy this
# stack to e2-micro/e2-small: ClamAV signature loading alone needs substantial
# memory and the configured container limits exceed those machines.
CLAMAV_MEMORY_LIMIT=4g
CLAMAV_CPU_LIMIT=2.0
MALWARE_WORKER_MEMORY_LIMIT=1g
MALWARE_WORKER_CPU_LIMIT=1.0
CLOUD_SQL_PROXY_MEMORY_LIMIT=256m
CLOUD_SQL_PROXY_CPU_LIMIT=0.5
CLOUD_SQL_PROXY_MAX_CONNECTIONS=10
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=5

# Hourly systemd timer bounds exact-generation quarantine cleanup work.
CLIENT_BLOB_UPLOAD_TTL_HOURS=24
CLIENT_BLOB_RECONCILE_BATCH_SIZE=100
