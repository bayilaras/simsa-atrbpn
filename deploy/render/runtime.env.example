# EXAMPLE ONLY. Add real values privately in the Render Dashboard.
# Never put Neon administrator/migration credentials in the web service.
NODE_ENV=production
SIMSA_APP_MODE=full
APP_PROFILE=internal
SIMSA_CLOUD_PLATFORM=local
AUTH_PROVIDER=better-auth
OBJECT_STORAGE_PROVIDER=disabled
MALWARE_SCANNER_MODE=disabled
MALWARE_SCAN_WORKER_ENABLED=false
MALWARE_SCAN_WORKER_RUNTIME=embedded
GOOGLE_OAUTH_ENABLED=false
SRIKANDI_ENABLED=false
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=15000
DATABASE_URL=postgresql://simsa_api:REPLACE_PRIVATELY@ep-replace-me.ap-southeast-1.aws.neon.tech/simsa_cloud?sslmode=verify-full
BETTER_AUTH_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Render fills RENDER_EXTERNAL_URL. Leave these absent to derive its HTTPS origin.
# FRONTEND_URL=https://your-assigned-service.onrender.com
# BETTER_AUTH_URL=https://your-assigned-service.onrender.com
