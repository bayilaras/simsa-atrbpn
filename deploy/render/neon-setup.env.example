# EXAMPLE ONLY. Copy into a private directory outside the repository before editing.
# Use a NEW empty Neon project/database. Never use the active local database.
NEON_EXPECTED_HOST=ep-replace-me.ap-southeast-1.aws.neon.tech
NEON_EXPECTED_DATABASE=simsa_cloud
NEON_EXPECTED_ADMIN=neondb_owner
NEON_EMPTY_PROJECT_ACKNOWLEDGED=true
# The administrator must own the selected database and have CREATEROLE.
NEON_ADMIN_DATABASE_URL=postgresql://neondb_owner:REPLACE_ADMIN_PRIVATELY@ep-replace-me.ap-southeast-1.aws.neon.tech/simsa_cloud?sslmode=verify-full
# Choose three DIFFERENT random passwords of at least 32 characters, URL-encoded.
# Bootstrap creates these SQL logins. Do not create them through the Neon Console.
NEON_RUNTIME_DATABASE_URL=postgresql://simsa_api:REPLACE_API_PRIVATELY@ep-replace-me.ap-southeast-1.aws.neon.tech/simsa_cloud?sslmode=verify-full
NEON_MIGRATION_DATABASE_URL=postgresql://simsa_migration:REPLACE_MIGRATION_PRIVATELY@ep-replace-me.ap-southeast-1.aws.neon.tech/simsa_cloud?sslmode=verify-full
NEON_OPERATOR_DATABASE_URL=postgresql://simsa_operator:REPLACE_OPERATOR_PRIVATELY@ep-replace-me.ap-southeast-1.aws.neon.tech/simsa_cloud?sslmode=verify-full
# The operator must establish ownership of this email before the first-admin step.
# This is a new application account, distinct from database login passwords.
FIRST_ADMIN_EMAIL=REPLACE_WITH_VERIFIED_EMAIL
FIRST_ADMIN_NAME=REPLACE_WITH_ADMINISTRATOR_NAME
FIRST_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD_16_TO_128_CHARACTERS
