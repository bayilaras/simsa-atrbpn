{
  "name": "simsa-firebase-spark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1 --port 5188 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:emulator": "npm run typecheck && vite build --mode emulator --outDir dist-emulator",
    "test": "node --test scripts/seed-emulator.test.mjs && vitest run",
    "test:rules": "vitest run --config vitest.emulator.config.ts",
    "test:emulator": "node scripts/emulators.mjs test",
    "emulators": "node scripts/emulators.mjs start",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "firebase-admin": "14.3.0",
    "firebase-tools": "15.29.0",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
