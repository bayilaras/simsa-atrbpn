rules_version = '2';

// Spark metadata pilot only. These rules do not enable file storage, trusted
// server audit, retention destruction, or any legacy SQL/Express workflow.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function profile() {
      return get(/databases/$(database)/documents/sparkUsers/$(request.auth.uid)).data;
    }

    function member(unitId) {
      return verified() && profile().active == true
        && profile().unitId == unitId
        && profile().role in ['viewer', 'operator', 'admin'];
    }

    function writer(unitId) {
      return member(unitId) && profile().role in ['operator', 'admin'];
    }

    function boundedQuery() {
      return request.query.limit is int
        && request.query.limit > 0 && request.query.limit <= 50;
    }

    function textSize(value, minimum, maximum, multiline) {
      return value is string && value.size() >= minimum && value.size() <= maximum
        && value == value.trim()
        && value.matches('^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$')
        && (multiline || value.matches('^[^\\r\\n\\t]*$'));
    }

    function catalogueId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$')
        && !value.matches('^__.*__$');
    }

    function leapYear(date) {
      let year = int(date.split('-')[0]);
      return year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
    }

    function recordDate(date) {
      return date is string && !date.matches('^0000-.*$') && (
        date.matches('^[0-9]{4}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$')
        || (date.matches('^[0-9]{4}-02-29$') && leapYear(date))
      );
    }

    function validRecord(data, unitId) {
      return data.keys().hasAll([
          'title', 'referenceNumber', 'recordDate', 'classificationId', 'locationId',
          'description', 'status', 'archiveReason', 'unitId', 'createdBy',
          'createdAt', 'updatedBy', 'updatedAt', 'version'
        ]) && data.keys().hasOnly([
          'title', 'referenceNumber', 'recordDate', 'classificationId', 'locationId',
          'description', 'status', 'archiveReason', 'unitId', 'createdBy',
          'createdAt', 'updatedBy', 'updatedAt', 'version'
        ])
        && textSize(data.title, 1, 200, false)
        && textSize(data.referenceNumber, 1, 100, false)
        && recordDate(data.recordDate)
        && catalogueId(data.classificationId) && catalogueId(data.locationId)
        && (data.status == 'archived' || (
          get(/databases/$(database)/documents/sparkUnits/$(unitId)/classifications/$(data.classificationId)).data.active == true
          && get(/databases/$(database)/documents/sparkUnits/$(unitId)/locations/$(data.locationId)).data.active == true
        ))
        && textSize(data.description, 0, 2000, true)
        && data.status in ['draft', 'active', 'archived']
        && ((data.status == 'archived' && textSize(data.archiveReason, 3, 500, true))
          || (data.status != 'archived' && data.archiveReason == ''))
        && catalogueId(unitId) && data.unitId == unitId
        && data.createdBy is string && data.createdBy.matches('^[A-Za-z0-9_-]{1,128}$')
        && !data.createdBy.matches('^__.*__$') && data.createdAt is timestamp
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time
        && data.updatedAt >= data.createdAt
        && data.updatedBy.matches('^[A-Za-z0-9_-]{1,128}$') && !data.updatedBy.matches('^__.*__$')
        && data.version is int && data.version > 0 && data.version < 9007199254740991;
    }

    function validInitialRecord(data) {
      return data.version == 1 && data.status in ['draft', 'active']
        && data.createdBy == request.auth.uid && data.createdAt == request.time;
    }

    function validTransition(before, after) {
      return before.status != 'archived' && after.version == before.version + 1
        && after.createdBy == before.createdBy && after.createdAt == before.createdAt
        && after.unitId == before.unitId
        // Closing is allowed after a catalogue is retired, but may not smuggle
        // an edit that would otherwise fail the active-catalogue requirement.
        && (after.status != 'archived' || after.diff(before).affectedKeys().hasOnly([
          'status', 'archiveReason', 'updatedBy', 'updatedAt', 'version'
        ]));
    }

    function validHistory(data, snapshot) {
      return data.keys().hasAll(['snapshot', 'actorUid', 'at'])
        && data.keys().hasOnly(['snapshot', 'actorUid', 'at'])
        && data.snapshot == snapshot
        && data.actorUid == request.auth.uid && data.at == request.time;
    }

    function hasNewHistory(unitId, recordId, data) {
      let eventId = 'v' + string(data.version);
      let eventPath = /databases/$(database)/documents/sparkUnits/$(unitId)/records/$(recordId)/history/$(eventId);
      return !exists(eventPath) && validHistory(getAfter(eventPath).data, data);
    }

    // No client, including a unit admin, can provision/escalate identities.
    match /sparkUsers/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /sparkUnits/{unitId} {
      allow get: if member(unitId);
      allow list, create, update, delete: if false;

      match /classifications/{id} {
        allow get: if member(unitId);
        allow list: if member(unitId) && boundedQuery();
        allow create, update, delete: if false;
      }

      match /locations/{id} {
        allow get: if member(unitId);
        allow list: if member(unitId) && boundedQuery();
        allow create, update, delete: if false;
      }

      match /records/{recordId} {
        allow get: if member(unitId);
        allow list: if member(unitId) && boundedQuery();
        allow create: if writer(unitId) && catalogueId(recordId) && validRecord(request.resource.data, unitId)
          && validInitialRecord(request.resource.data)
          && hasNewHistory(unitId, recordId, request.resource.data);
        allow update: if writer(unitId) && catalogueId(recordId) && validRecord(request.resource.data, unitId)
          && validTransition(resource.data, request.resource.data)
          && hasNewHistory(unitId, recordId, request.resource.data);
        allow delete: if false;

        match /history/{eventId} {
          allow get: if member(unitId);
          allow list: if member(unitId) && boundedQuery();
          allow create: if writer(unitId)
            && eventId == 'v' + string(request.resource.data.snapshot.version)
            && validHistory(request.resource.data,
              getAfter(/databases/$(database)/documents/sparkUnits/$(unitId)/records/$(recordId)).data)
            && (
              (!exists(/databases/$(database)/documents/sparkUnits/$(unitId)/records/$(recordId))
                && validInitialRecord(request.resource.data.snapshot))
              || (exists(/databases/$(database)/documents/sparkUnits/$(unitId)/records/$(recordId))
                && validTransition(
                  get(/databases/$(database)/documents/sparkUnits/$(unitId)/records/$(recordId)).data,
                  request.resource.data.snapshot))
            );
          allow update, delete: if false;
        }
      }
    }

    // No recursive rule grants collection-group access or legacy collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
