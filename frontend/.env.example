# Frontend Environment Variables
# Copy to .env.local for development or .env.production for production

# Backend API URL (REQUIRED)
VITE_API_URL=http://localhost:3001

# Deployment profile. Supported values: internal, integrated.
# Missing or unknown values fail closed to internal.
VITE_APP_PROFILE=internal

# SRIKANDI is exposed only when the profile is integrated AND this flag is true.
VITE_FEATURE_SRIKANDI=false
