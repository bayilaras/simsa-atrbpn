# Frontend Environment Variables
# Copy to .env.local for development or .env.production for production

# Leave blank locally as well: Vite proxies /api to localhost:3001, keeping
# cookies and direct-upload token requests on the same frontend origin.
# Every production host also needs a same-origin /api reverse proxy;
# Vercel uses the server-only API_PROXY_ORIGIN for that proxy.
VITE_API_URL=

# Production providers. Better Auth is the only supported sign-in provider.
VITE_AUTH_PROVIDER=better-auth
VITE_STORAGE_PROVIDER=vercel-blob

# Vercel-only, server-side variables (never prefix these with VITE_):
# API_PROXY_ORIGIN=https://simsa-backend-git-your-branch-bayilaras-projects.vercel.app
# BACKEND_VERCEL_PROTECTION_BYPASS=<backend Automation Bypass secret>
# If API_PROXY_ORIGIN is absent on Preview, Vercel deploys a no-store 503
# maintenance-only artifact (without the SPA bundle) and never falls back to
# the Production backend.

# Deployment profile. Supported values: internal, integrated.
# Missing or unknown values fail closed to internal.
VITE_APP_PROFILE=internal

# SRIKANDI is exposed only when the profile is integrated AND this flag is true.
VITE_FEATURE_SRIKANDI=false
