{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://simsa-backend.vercel.app/api/:path*"
        },
        {
            "source": "/health",
            "destination": "https://simsa-backend.vercel.app/health"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://simsa-backend.vercel.app/uploads/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}